{
	"servers": {
		"cutover-mcp": {
			"type": "stdio",
			"command": "uvx",
			"args": ["cutover-mcp"],
			"env": {
				"CUTOVER_BASE_URL": "https://api.cutover.net",
				"CUTOVER_API_TOKEN": "${input:cutover-api-token}",
				"CUTOVER_CORE_URL": "https://YOUR-INSTANCE-NAME.cutover.com"
			}
		}
	},
	"inputs": [
		{
			"id": "cutover-api-token",
			"type": "promptString",
			"description": "Cutover API token (My Details > User App Tokens)",
			"password": true
		}
	]
}
