# Environment variables for Cutover MCP.

# Your environment's API host. Production shown; use the host you were given for a different environment or a dedicated instance.
CUTOVER_BASE_URL=https://api.cutover.net

# See README "Generating an API Token".
CUTOVER_API_TOKEN=your_token_here

# Replace YOUR-INSTANCE-NAME with your instance's name.
CUTOVER_CORE_URL=https://YOUR-INSTANCE-NAME.cutover.com
