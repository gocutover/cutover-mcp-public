# Environment variables for Cutover MCP.
# CUTOVER_CORE_URL / CUTOVER_API_TOKEN / CUTOVER_BASE_URL are resolved in this order per request:
# 1. Core-Url / Authorization / Base-Url HTTP headers (streamable-http, per-user)
# 2. These env vars (stdio / local development)
# 3. An interactive prompt to the connected client, if it supports elicitation

# Your Cutover instance URL. Replace YOUR-INSTANCE-NAME with your instance's name.
CUTOVER_CORE_URL=https://YOUR-INSTANCE-NAME.cutover.com

# See README "Generating an API Token".
CUTOVER_API_TOKEN=your_token_here

# The Cutover API host. Leave unset to derive it from CUTOVER_CORE_URL (https://api.cutover.net
# for production instances). Set it only for a single-tenant instance with its own API host,
# or for local public-api (http://localhost:9292).
# CUTOVER_BASE_URL=https://api.cutover.net

# Transport configuration (stdio for local, streamable-http for containerized/remote deployments)
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
